{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test:selenium": "cross-env OPEN_UI=true node tests/e2e/selenium-web-test.js",
    "test:selenium:review": "cross-env OPEN_UI=true KEEP_OPEN=true node tests/e2e/selenium-web-test.js",
    "test:selenium:ci": "node tests/e2e/selenium-web-test.js",
    "test:appium": "node tests/appium/mobile-appium-test.js",
    "test:appium:analysis": "node tests/appium/report/generate-appium-analysis.js",
    "test:appium:all": "node tests/appium/mobile-appium-test.js && node tests/appium/report/generate-appium-analysis.js",
    "test:security": "node tests/scripts/generate-security-report.js",
    "test:report": "node tests/report/generate-report.js",
    "test:unit": "vitest run",
    "test:all": "pnpm test:unit && pnpm test:selenium:ci && pnpm test:appium && pnpm test:appium:analysis && pnpm test:report"
  },
  "dependencies": {
    "@capacitor/android": "^8.4.0",
    "@capacitor/core": "^8.4.0",
    "@supabase/supabase-js": "^2.108.2",
    "@tailwindcss/vite": "4.2.2",
    "axios": "^1.13.6",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "framer-motion": "^12.38.0",
    "lucide-react": "^1.0.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-ga4": "^3.0.1",
    "react-icons": "^5.6.0",
    "react-router-dom": "^7.14.0",
    "recharts": "^3.8.0",
    "tailwindcss": "4.2.2"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.4.0",
    "@eslint/js": "^9.39.4",
    "@testing-library/jest-dom": "^6.0.2",
    "@testing-library/react": "^14.0.0",
    "@vitejs/plugin-react": "^6.0.1",
    "appium": "^2.0.0",
    "cross-env": "^10.1.0",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "exceljs": "^4.4.0",
    "globals": "^17.4.0",
    "jsdom": "^22.1.0",
    "selenium-webdriver": "^4.13.0",
    "vite": "^8.0.1",
    "vitest": "^0.34.0",
    "wd": "^1.14.0"
  }
}
